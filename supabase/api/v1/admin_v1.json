{
  "openapi": "3.1.0",
  "info": {
    "title": "機車停車指南 管理 API（admin_v1）",
    "version": "1.0.0",
    "description": "只有管理員（role admin＋第二步驗證）可用的 API（#195）。每支函式是 PostgREST 的 RPC：POST /rest/v1/rpc/<name>，以 Content-Profile: admin_v1 指定 schema（x-content-profile；由用戶端的 base 自動帶上，不是每支 operation 的參數）；非管理員一律回 403 auth.aal2_required。"
  },
  "x-content-profile": "admin_v1",
  "servers": [
    {
      "url": "/rest/v1"
    }
  ],
  "paths": {
    "/rpc/set_min_supported_app_version": {
      "post": {
        "operationId": "admin_v1_set_min_supported_app_version",
        "summary": "設定 App 的最低支援版本",
        "description": "唯一能修改 client_config.min_supported_app_version 的途徑，每次修改都寫入 admin_audit_log。管理員（aal2）可以調高或調低；CD（service_role）只能調高，調低或相同時不動，並回 changed: false，p_reason 帶上 run 的網址。調高前要先確認新版已在 App Store 與 Google Play 上架。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_version",
                  "p_reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                    "description": "新的最低版本 x.y.z"
                  },
                  "p_reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "原因；CD 帶上 run 的網址"
                  }
                },
                "example": {
                  "p_version": "0.1.0",
                  "p_reason": "contract check"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "目前生效的最低版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinAppVersion"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/support_requests": {
      "post": {
        "operationId": "admin_v1_support_requests",
        "summary": "客服表單的申請（#269）",
        "description": "無法登入者從 App 外刪除網頁送出的申請，新的在前；唯讀紀錄與例外清單（#285）。登入信箱的主人在確認頁按「是我」後由系統直接建立刪除申請，管理員不代為申請。含 email 供客服回覆一般問題；不要轉貼到其他地方，也不要告訴對方是否找到帳號。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "p_status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "done",
                      "rejected",
                      "voided",
                      "expired",
                      "exception",
                      "all"
                    ],
                    "default": "open",
                    "description": "只列這個狀態；all 列全部"
                  },
                  "p_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200,
                    "default": 50
                  }
                },
                "example": {
                  "p_status": "open",
                  "p_limit": 50
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "申請",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SupportRequest"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/resolve_support_request": {
      "post": {
        "operationId": "admin_v1_resolve_support_request",
        "summary": "客服申請結案",
        "description": "done（已處理）或 rejected（無法確認身分等）。寫入 admin_audit_log（不記 email 與內容）。結案 180 天後自動刪除。錯誤：400 request.invalid、404 support.not_found、409 support.already_resolved。 只用於一般客服問題與還在 open（已寄確認信）的申請；系統判定的終止狀態不能結案（#285）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_id",
                  "p_status"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "p_status": {
                    "type": "string",
                    "enum": [
                      "done",
                      "rejected"
                    ]
                  },
                  "p_note": {
                    "type": "string",
                    "maxLength": 500,
                    "default": ""
                  }
                },
                "example": {
                  "p_id": "00000000-0000-4000-8000-000000000000",
                  "p_status": "done",
                  "p_note": ""
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "結案結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportResolution"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "SQLSTATE；API 自訂錯誤為 PTxyz，HTTP 狀態即 xyz"
          },
          "message": {
            "type": "string",
            "description": "穩定錯誤碼，例如 auth.aal2_required；用戶端依此顯示文案"
          },
          "details": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON 字串，帶欄位等細節"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MinAppVersion": {
        "type": "object",
        "required": [
          "min_supported_app_version",
          "changed"
        ],
        "additionalProperties": false,
        "properties": {
          "min_supported_app_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "目前生效的最低版本"
          },
          "changed": {
            "type": "boolean",
            "description": "這次呼叫是否改了值"
          }
        }
      },
      "SupportRequest": {
        "type": "object",
        "description": "一筆客服申請",
        "required": [
          "id",
          "kind",
          "contact_email",
          "account_hint",
          "message",
          "status",
          "created_at",
          "notified_at",
          "resolved_at",
          "resolution_note",
          "deletion_requested",
          "login_email",
          "account_matched",
          "matched_user",
          "email_confirmed_at",
          "exception",
          "deletion_notified_at",
          "cancelled_at",
          "superseded_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "account_deletion"
            ]
          },
          "contact_email": {
            "type": "string",
            "description": "聯絡用 email，已轉小寫；只寄固定回條（#285）。回覆時不要透露是否找到帳號"
          },
          "account_hint": {
            "type": "string",
            "description": "申請者說明的帳號線索（登入方式、當時的 email 或名稱）"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "done",
              "rejected",
              "voided",
              "expired",
              "exception"
            ],
            "description": "open：已寄確認信，等登入信箱的主人確認；done：已確認並建立刪除申請（或客服結案）；rejected：客服結案；voided：申請者按「不是我申請的」，或重送後被取代；expired：確認連結過期；exception：系統例外，只記錄（見 exception）。open 以外都有 resolved_at"
          },
          "created_at": {
            "type": "string",
            "description": "ISO 8601 時間。送出時間"
          },
          "notified_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。通知信寄出時間；沒有寄信服務時為 null"
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。結束時間（系統判定或客服結案）；滿 180 天後刪除"
          },
          "resolution_note": {
            "type": "string"
          },
          "deletion_requested": {
            "type": "boolean",
            "description": "已建立刪除申請"
          },
          "login_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "申請者填的帳號登入 email，已轉小寫，只用來比對帳號；確認信與通知信只寄到這裡（#285）。#285 之前的申請為 null"
          },
          "account_matched": {
            "type": "boolean",
            "description": "送出時登入 email 正好是一個帳號的（auth.users 或 auth.identities，不分大小寫，含 Apple 隱藏的電子郵件）"
          },
          "matched_user": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "對到的帳號；沒對到或帳號已刪除時為 null"
          },
          "email_confirmed_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。登入信箱的主人在確認頁按「是我」的時間"
          },
          "exception": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "no_account",
              "admin_account",
              "deletion_pending",
              "deletion_in_progress",
              "account_deleted",
              null
            ],
            "description": "系統例外的原因（status 為 exception 時）：no_account 沒對到帳號、admin_account 管理員帳號、deletion_pending 已在冷靜期（已寄狀態信到登入 email）、deletion_in_progress 正在刪除、account_deleted 已刪除。不建立刪除申請"
          },
          "deletion_notified_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。建立刪除申請後寄到登入 email 的通知信寄出時間"
          },
          "cancelled_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。以通知信的「取消刪除」連結取消的時間（#285）"
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "重送時取代這筆的申請（status 為 voided）"
          }
        }
      },
      "SupportResolution": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "rejected"
            ]
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "錯誤（#195 §2.4）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
