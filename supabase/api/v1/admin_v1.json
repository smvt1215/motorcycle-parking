{
  "openapi": "3.1.0",
  "info": {
    "title": "機車停車指南 管理 API（admin_v1）",
    "version": "1.0.0",
    "description": "只有管理員（role admin＋第二步驗證）可用的 API（#195）。每支函式是 PostgREST 的 RPC：POST /rest/v1/rpc/<name>，以 Content-Profile: admin_v1 指定 schema（x-content-profile；由用戶端的 base 自動帶上，不是每支 operation 的參數）；非管理員一律回 403 auth.aal2_required。"
  },
  "x-content-profile": "admin_v1",
  "servers": [
    {
      "url": "/rest/v1"
    }
  ],
  "paths": {
    "/rpc/set_min_supported_app_version": {
      "post": {
        "operationId": "admin_v1_set_min_supported_app_version",
        "summary": "設定 App 的最低支援版本",
        "description": "唯一能修改 client_config.min_supported_app_version 的途徑，每次修改都寫入 admin_audit_log。管理員（aal2）可以調高或調低；CD（service_role）只能調高，調低或相同時不動，並回 changed: false，p_reason 帶上 run 的網址。調高前要先確認新版已在 App Store 與 Google Play 上架。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_version",
                  "p_reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                    "description": "新的最低版本 x.y.z"
                  },
                  "p_reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "原因；CD 帶上 run 的網址"
                  }
                },
                "example": {
                  "p_version": "0.1.0",
                  "p_reason": "contract check"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "目前生效的最低版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinAppVersion"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/support_requests": {
      "post": {
        "operationId": "admin_v1_support_requests",
        "summary": "客服案件列表（#269、#295）",
        "description": "新的在前。表單、寄到 support@ 的信都是案件；刪除帳號與個資權利請求的確認流程由系統處理（#285）。含 email 供客服回覆；不要轉貼到其他地方，也不要告訴對方是否找到帳號。管理站預設檢視「待回覆」＝p_status open、p_awaiting_admin true。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "p_status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "done",
                      "rejected",
                      "voided",
                      "expired",
                      "exception",
                      "all"
                    ],
                    "default": "open",
                    "description": "只列這個狀態；all 列全部"
                  },
                  "p_kind": {
                    "type": "string",
                    "enum": [
                      "general",
                      "data_issue",
                      "complaint",
                      "privacy",
                      "account_deletion",
                      "all"
                    ],
                    "default": "all",
                    "description": "只列這個類型；all 列全部"
                  },
                  "p_awaiting_admin": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "default": null,
                    "description": "true 只列等客服回覆的、false 只列不等的；null 不篩"
                  },
                  "p_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200,
                    "default": 50
                  }
                },
                "example": {
                  "p_status": "open",
                  "p_kind": "all",
                  "p_awaiting_admin": true,
                  "p_limit": 50
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "申請",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SupportRequest"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/resolve_support_request": {
      "post": {
        "operationId": "admin_v1_resolve_support_request",
        "summary": "客服申請結案",
        "description": "done（已處理）或 rejected（無法確認身分等）。寫入 admin_audit_log（不記 email 與內容）。結案 180 天後自動刪除；30 天內使用者補充或回信會重新開啟。錯誤：400 request.invalid、404 support.not_found、409 support.already_resolved。系統判定的終止狀態不能結案（#285）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_id",
                  "p_status"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "p_status": {
                    "type": "string",
                    "enum": [
                      "done",
                      "rejected"
                    ]
                  },
                  "p_note": {
                    "type": "string",
                    "maxLength": 500,
                    "default": ""
                  }
                },
                "example": {
                  "p_id": "00000000-0000-4000-8000-000000000000",
                  "p_status": "done",
                  "p_note": ""
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "結案結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportResolution"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/support_request": {
      "post": {
        "operationId": "admin_v1_support_request",
        "summary": "客服案件詳情（#295）",
        "description": "案件與往來紀錄（舊到新，第一則是原始內容）；含 email 與寄送結果。錯誤：400 request.invalid、404 support.not_found。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "example": {
                  "p_id": "00000000-0000-4000-8000-000000000000"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "案件詳情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportRequestDetail"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/reply_support_request": {
      "post": {
        "operationId": "admin_v1_reply_support_request",
        "summary": "回覆客服案件（#295）",
        "description": "只限 open 且 can_reply 的案件。存下內文後由系統經 Resend 寄到 reply_to（From support@、Reply-To 帶案件 token 的 reply+…@，內文附案件連結）；寄送結果記在回傳這則的 delivery_status，失敗自動重試最多 5 次。每案件每台灣日 10 則、總計 50 則。寫入 admin_audit_log（不記內文與 email）。錯誤：400 request.invalid、404 support.not_found、409 support.already_resolved、409 support.reply_not_allowed（刪除帳號，或個資權利請求還沒確認本人）、429 support.reply_limited。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_id",
                  "p_body"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "p_body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "description": "回覆內文（純文字）"
                  }
                },
                "example": {
                  "p_id": "00000000-0000-4000-8000-000000000000",
                  "p_body": "您好，已更正，謝謝回報。"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "這則回覆（delivery_status queued）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportMessage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "SQLSTATE；API 自訂錯誤為 PTxyz，HTTP 狀態即 xyz"
          },
          "message": {
            "type": "string",
            "description": "穩定錯誤碼，例如 auth.aal2_required；用戶端依此顯示文案"
          },
          "details": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON 字串，帶欄位等細節"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MinAppVersion": {
        "type": "object",
        "required": [
          "min_supported_app_version",
          "changed"
        ],
        "additionalProperties": false,
        "properties": {
          "min_supported_app_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "目前生效的最低版本"
          },
          "changed": {
            "type": "boolean",
            "description": "這次呼叫是否改了值"
          }
        }
      },
      "SupportRequest": {
        "type": "object",
        "description": "一筆客服案件（#269、#285、#295）",
        "required": [
          "id",
          "kind",
          "contact_email",
          "account_hint",
          "message",
          "status",
          "created_at",
          "notified_at",
          "resolved_at",
          "resolution_note",
          "deletion_requested",
          "login_email",
          "account_matched",
          "matched_user",
          "email_confirmed_at",
          "exception",
          "deletion_notified_at",
          "cancelled_at",
          "superseded_by",
          "source",
          "subject",
          "privacy_right",
          "due_at",
          "reply_to",
          "can_reply",
          "message_count",
          "last_message_at",
          "awaiting_admin",
          "suspicious",
          "reopened_at",
          "related_to"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "general",
              "data_issue",
              "complaint",
              "privacy",
              "account_deletion"
            ],
            "description": "general 一般問題、data_issue 資料錯誤或侵權、complaint 檢舉與申訴、privacy 個資權利請求、account_deletion 刪除帳號（#285）"
          },
          "contact_email": {
            "type": "string",
            "description": "聯絡用 email，已轉小寫。一般案件的回覆寄到這裡；刪除帳號與個資權利請求只寄固定回條（#285）。回覆時不要透露是否找到帳號"
          },
          "account_hint": {
            "type": "string",
            "description": "申請者說明的帳號線索（登入方式、當時的 email 或名稱）"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "done",
              "rejected",
              "voided",
              "expired",
              "exception"
            ],
            "description": "open：處理中（刪除帳號與個資權利請求未確認時是等登入信箱的主人確認）；done／rejected：客服結案（30 天內使用者補充或回信會重新開啟）；done 也是刪除帳號已確認並建立申請；voided：申請者按「不是我申請的」，或重送後被取代；expired：確認連結過期；exception：系統例外，只記錄（見 exception）。open 以外都有 resolved_at"
          },
          "created_at": {
            "type": "string",
            "description": "ISO 8601 時間。送出時間"
          },
          "notified_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。通知信寄出時間；沒有寄信服務時為 null"
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。結束時間（系統判定或客服結案）；滿 180 天後刪除"
          },
          "resolution_note": {
            "type": "string"
          },
          "deletion_requested": {
            "type": "boolean",
            "description": "已建立刪除申請"
          },
          "login_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "申請者填的帳號登入 email（刪除帳號與個資權利請求），已轉小寫；確認信、通知信與個資權利請求的回覆只寄到這裡（#285、#295）。其他類型為 null"
          },
          "account_matched": {
            "type": "boolean",
            "description": "送出時登入 email 正好是一個帳號的（auth.users 或 auth.identities，不分大小寫，含 Apple 隱藏的電子郵件）"
          },
          "matched_user": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "對到的帳號；沒對到或帳號已刪除時為 null"
          },
          "email_confirmed_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。登入信箱的主人在確認頁按「是我」的時間；個資權利請求要有它才能回覆"
          },
          "exception": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "no_account",
              "admin_account",
              "deletion_pending",
              "deletion_in_progress",
              "account_deleted",
              null
            ],
            "description": "系統例外的原因（status 為 exception 時）：no_account 沒對到帳號、admin_account 管理員帳號、deletion_pending 已在冷靜期（已寄狀態信到登入 email）、deletion_in_progress 正在刪除、account_deleted 已刪除。不建立刪除申請"
          },
          "deletion_notified_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。建立刪除申請後寄到登入 email 的通知信寄出時間"
          },
          "cancelled_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。以通知信的「取消刪除」連結取消的時間（#285）"
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "重送時取代這筆的申請（status 為 voided）"
          },
          "source": {
            "type": "string",
            "enum": [
              "web",
              "email"
            ],
            "description": "web 客服表單、email 寄到 support@ 的信"
          },
          "subject": {
            "type": "string",
            "description": "主旨（email 來源為信件主旨；表單可為空字串）"
          },
          "privacy_right": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "access",
              "correction",
              "copy",
              null
            ],
            "description": "個資權利請求的項目：access 查詢、correction 更正、copy 複本；其他類型為 null"
          },
          "due_at": {
            "type": "string",
            "description": "ISO 8601 時間。回覆期限：送出（或重新開啟）後 5 個工作天結束（台灣時間；依 public.holidays，補班日算工作日）"
          },
          "reply_to": {
            "type": [
              "string",
              "null"
            ],
            "description": "客服回覆會寄到的地址；不能回覆時 null（刪除帳號、個資權利請求未確認）"
          },
          "can_reply": {
            "type": "boolean",
            "description": "現在可以回覆：open 且 reply_to 不是 null"
          },
          "message_count": {
            "type": "integer",
            "minimum": 0,
            "description": "往來則數（不含原始內容）"
          },
          "last_message_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。最後一則往來的時間"
          },
          "awaiting_admin": {
            "type": "boolean",
            "description": "等客服回覆：可以回覆，且還沒有往來或最後一則是使用者的"
          },
          "suspicious": {
            "type": "boolean",
            "description": "原始信件或任一封回信的 SPF／DKIM 未通過"
          },
          "reopened_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。最近一次因使用者補充或回信重新開啟的時間"
          },
          "related_to": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "結案超過 30 天後收到回信而開的新案件：指向舊案"
          }
        }
      },
      "SupportResolution": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "rejected"
            ]
          }
        }
      },
      "SupportMessage": {
        "type": "object",
        "description": "案件的一則往來（#295）。詳情的第一則是原始內容（id 為案件編號、channel 為來源 web 或 email）",
        "additionalProperties": false,
        "required": [
          "id",
          "direction",
          "channel",
          "body",
          "created_at",
          "author",
          "from_email",
          "suspicious",
          "spf",
          "dkim",
          "attachments",
          "to_email",
          "delivery_status",
          "attempts",
          "sent_at",
          "send_error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ],
            "description": "in 使用者、out 客服回覆"
          },
          "channel": {
            "type": "string",
            "enum": [
              "web",
              "email",
              "case_link",
              "admin"
            ],
            "description": "web 表單原始內容、email 信件（原始或回信）、case_link 案件連結的補充、admin 管理站回覆"
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "description": "ISO 8601 時間"
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "回覆的管理員（out）"
          },
          "from_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "信件的寄件人（channel email）"
          },
          "suspicious": {
            "type": "boolean",
            "description": "SPF 或 DKIM 未通過"
          },
          "spf": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pass",
