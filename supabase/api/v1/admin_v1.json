{
  "openapi": "3.1.0",
  "info": {
    "title": "機車停車指南 管理 API（admin_v1）",
    "version": "1.0.0",
    "description": "只有管理員（role admin＋第二步驗證）可用的 API（#195）。每支函式是 PostgREST 的 RPC：POST /rest/v1/rpc/<name>，以 Content-Profile: admin_v1 指定 schema（x-content-profile；由用戶端的 base 自動帶上，不是每支 operation 的參數）；非管理員一律回 403 auth.aal2_required。"
  },
  "x-content-profile": "admin_v1",
  "servers": [
    {
      "url": "/rest/v1"
    }
  ],
  "paths": {
    "/rpc/set_min_supported_app_version": {
      "post": {
        "operationId": "admin_v1_set_min_supported_app_version",
        "summary": "設定 App 的最低支援版本",
        "description": "唯一能修改 client_config.min_supported_app_version 的途徑，每次修改都寫入 admin_audit_log。管理員（aal2）可以調高或調低；CD（service_role）只能調高，調低或相同時不動，並回 changed: false，p_reason 帶上 run 的網址。調高前要先確認新版已在 App Store 與 Google Play 上架。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_version",
                  "p_reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                    "description": "新的最低版本 x.y.z"
                  },
                  "p_reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "原因；CD 帶上 run 的網址"
                  }
                },
                "example": {
                  "p_version": "0.1.0",
                  "p_reason": "contract check"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "目前生效的最低版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinAppVersion"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/support_requests": {
      "post": {
        "operationId": "admin_v1_support_requests",
        "summary": "客服表單的申請（#269）",
        "description": "無法登入者從 App 外刪除網頁送出的申請，新的在前。含聯絡 email 供管理員回覆；不要轉貼到其他地方。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "p_status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "open",
                      "done",
                      "rejected",
                      null
                    ],
                    "default": "open",
                    "description": "只列這個狀態；null 列全部"
                  },
                  "p_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200,
                    "default": 50
                  }
                },
                "example": {
                  "p_status": "open",
                  "p_limit": 50
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "申請",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SupportRequest"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/resolve_support_request": {
      "post": {
        "operationId": "admin_v1_resolve_support_request",
        "summary": "客服申請結案",
        "description": "done（已處理）或 rejected（無法確認身分等）。寫入 admin_audit_log（不記 email 與內容）。結案 180 天後自動刪除。錯誤：400 request.invalid、404 support.not_found、409 support.already_resolved。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_id",
                  "p_status"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "p_status": {
                    "type": "string",
                    "enum": [
                      "done",
                      "rejected"
                    ]
                  },
                  "p_note": {
                    "type": "string",
                    "maxLength": 500,
                    "default": ""
                  }
                },
                "example": {
                  "p_id": "00000000-0000-4000-8000-000000000000",
                  "p_status": "done",
                  "p_note": ""
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "結案結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportResolution"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/request_account_deletion_for": {
      "post": {
        "operationId": "admin_v1_request_account_deletion_for",
        "summary": "確認身分後代為申請刪除帳號（#269）",
        "description": "依客服申請代為建立刪除申請：與自助申請相同的 7 天冷靜期、立即隱藏公開名稱；本人冷靜期內登入會自動取消。已有申請時回原申請。寫入 admin_audit_log。錯誤：400 request.invalid、404 support.not_found／account.not_found、409 support.already_resolved、403 account.admin_cannot_self_delete（管理員帳號要先移除權限）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_user",
                  "p_support_request"
                ],
                "additionalProperties": false,
                "properties": {
                  "p_user": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "description": "要刪除的帳號"
                  },
                  "p_support_request": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "description": "客服申請編號"
                  },
                  "p_note": {
                    "type": "string",
                    "maxLength": 500,
                    "default": "",
                    "description": "如何確認身分"
                  }
                },
                "example": {
                  "p_user": "00000000-0000-4000-8000-000000000000",
                  "p_support_request": "00000000-0000-4000-8000-000000000000",
                  "p_note": ""
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "刪除申請的狀態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAccountDeletion"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "SQLSTATE；API 自訂錯誤為 PTxyz，HTTP 狀態即 xyz"
          },
          "message": {
            "type": "string",
            "description": "穩定錯誤碼，例如 auth.aal2_required；用戶端依此顯示文案"
          },
          "details": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON 字串，帶欄位等細節"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MinAppVersion": {
        "type": "object",
        "required": [
          "min_supported_app_version",
          "changed"
        ],
        "additionalProperties": false,
        "properties": {
          "min_supported_app_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "目前生效的最低版本"
          },
          "changed": {
            "type": "boolean",
            "description": "這次呼叫是否改了值"
          }
        }
      },
      "SupportRequest": {
        "type": "object",
        "description": "一筆客服申請",
        "required": [
          "id",
          "kind",
          "contact_email",
          "account_hint",
          "message",
          "status",
          "created_at",
          "notified_at",
          "resolved_at",
          "resolution_note",
          "deletion_requested"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "account_deletion"
            ]
          },
          "contact_email": {
            "type": "string",
            "description": "回覆用，已轉小寫"
          },
          "account_hint": {
            "type": "string",
            "description": "申請者說明的帳號線索（登入方式、當時的 email 或名稱）"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "done",
              "rejected"
            ]
          },
          "created_at": {
            "type": "string",
            "description": "ISO 8601 時間。送出時間"
          },
          "notified_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。通知信寄出時間；沒有寄信服務時為 null"
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。結案時間"
          },
          "resolution_note": {
            "type": "string"
          },
          "deletion_requested": {
            "type": "boolean",
            "description": "已代為建立刪除申請"
          }
        }
      },
      "SupportResolution": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "rejected"
            ]
          }
        }
      },
      "AdminAccountDeletion": {
        "type": "object",
        "description": "帳號的刪除申請狀態（同 api_v1 的 AccountDeletionState）與客服申請編號",
        "required": [
          "status",
          "requested_at",
          "scheduled_at",
          "cancelled_at",
          "cancelled_by_sign_in",
          "can_self_delete",
          "cannot_self_delete_reason",
          "support_request"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "pending"
            ]
          },
          "requested_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。申請時間"
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。最早刪除時間（申請＋7 天）"
          },
          "cancelled_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。最近一次取消"
          },
          "cancelled_by_sign_in": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "can_self_delete": {
            "type": "boolean",
            "description": "帳號能不能自助申請刪除（管理員為 false）"
          },
          "cannot_self_delete_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "account.admin_cannot_self_delete",
              null
            ]
          },
          "support_request": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "錯誤（#195 §2.4）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
