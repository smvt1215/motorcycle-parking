      "DataVersions": {
        "type": "object",
        "description": "資料集名稱 → 版本號（正整數）。目前有 rules、spots；新增的資料集會出現新的鍵，用戶端遇到不認識的鍵請略過",
        "required": [
          "rules",
          "spots"
        ],
        "properties": {
          "rules": {
            "type": "integer",
            "minimum": 1
          },
          "spots": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 1
        }
      },
      "AccountDeletionState": {
        "type": "object",
        "description": "帳號刪除申請的狀態（#215）",
        "required": [
          "status",
          "requested_at",
          "scheduled_at",
          "can_self_delete",
          "cannot_self_delete_reason"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "pending"
            ],
            "description": "none：沒有申請；pending：冷靜期中，到 scheduled_at 後刪除"
          },
          "requested_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。申請時間；none 時為 null"
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。最早刪除時間（申請＋7 天），實際在之後的每日排程（台灣 03:41）執行；none 時為 null"
          },
          "can_self_delete": {
            "type": "boolean",
            "description": "這個帳號能不能自助申請刪除；管理員為 false（要先由其他管理員移除權限）。App 在刪除說明頁就依此提示"
          },
          "cannot_self_delete_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "account.admin_cannot_self_delete",
              null
            ],
            "description": "不能自助刪除的原因（錯誤碼）；可以時為 null"
          }
        }
      },
