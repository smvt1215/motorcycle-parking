{
  "openapi": "3.1.0",
  "info": {
    "title": "機車停車指南 公開 API（api_v1）",
    "version": "1.0.0",
    "description": "App 與管理站共用的公開 API（#195）。每支函式是 PostgREST 的 RPC：POST /rest/v1/rpc/<name>，以 Content-Profile: api_v1 指定 schema（x-content-profile；由用戶端的 base 自動帶上，不是每支 operation 的參數）。v1 只做加法，破壞性變更開 api_v2。"
  },
  "x-content-profile": "api_v1",
  "servers": [
    {
      "url": "/rest/v1"
    }
  ],
  "paths": {
    "/rpc/client_config": {
      "post": {
        "operationId": "api_v1_client_config",
        "summary": "最低支援版本與各資料集的版本",
        "description": "App 啟動、回到前景、恢復連線時讀取（#195 §2.1、#202）。不需要登入。",
        "responses": {
          "200": {
            "description": "版本資訊",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfig"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/city_rules": {
      "post": {
        "operationId": "api_v1_city_rules",
        "summary": "全部縣市規則與整體的規則版本",
        "description": "App 在 client_config 的 rules_version 比快取新時讀取（#195 P2、#202）；資料列照原樣提供，過期（expires_on）由 App 自行判斷，判斷結果一律在 App 本地計算。不需要登入。",
        "responses": {
          "200": {
            "description": "規則",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityRules"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/spots_in_viewport": {
      "post": {
        "operationId": "api_v1_spots_in_viewport",
        "summary": "地圖範圍內的官方點與社群點",
        "description": "官方點（source=official，id 以 official: 開頭）與社群點合併回傳，各最多 500 筆。篩選與欄位沿用 official_viewport_spots_v3 與 viewport_spots_v3。不帶判斷結果，判斷一律在 App 本地計算（#195 §7 第 4 題）；即時空位另以 viewport_availability 讀取。範圍不合法（north≤south、east≤west 或任一邊超過 0.5°）時回空清單。官方那層讀取失敗時只略過官方點，並回 official_unavailable: true。不需要登入。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "south",
                  "west",
                  "north",
                  "east"
                ],
                "additionalProperties": false,
                "properties": {
                  "south": {
                    "type": "number",
                    "description": "WGS84 度"
                  },
                  "west": {
                    "type": "number",
                    "description": "WGS84 度"
                  },
                  "north": {
                    "type": "number",
                    "description": "WGS84 度"
                  },
                  "east": {
                    "type": "number",
                    "description": "WGS84 度"
                  }
                },
                "example": {
                  "south": 25.02,
                  "west": 121.55,
                  "north": 25.05,
                  "east": 121.58
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "範圍內的點",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpotsInViewport"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/data_versions": {
      "post": {
        "operationId": "api_v1_data_versions",
        "summary": "各資料集目前的版本",
        "description": "App 快取的每個資料集（rules、spots，之後可能增加）的版本號，數字變大就表示要重讀。版本變動時會在公開的 Realtime Broadcast topic `data_versions` 發出 event `bump`，payload 為 {key, version}。公開 topic 任何人都能送訊息，所以 Broadcast 只是提示：收到後請重新呼叫這支 API，依回傳值決定要不要重讀。不需要登入。",
        "responses": {
          "200": {
            "description": "資料集 → 版本",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataVersions"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/account_deletion_status": {
      "post": {
        "operationId": "api_v1_account_deletion_status",
        "summary": "自己帳號的刪除申請狀態",
        "description": "要登入（不可匿名登入）。冷靜期內已登入的 session 照常可讀。App 登入後讀取：status 為 pending 時顯示確認頁（預定刪除時間 scheduled_at），讓使用者選「取消刪除」（cancel_account_deletion）或「繼續刪除」（不需呼叫，維持原申請）；can_self_delete 為 false 時在說明頁提示原因（#215）。錯誤：401 auth.sign_in_required。",
        "x-requires-sign-in": true,
        "responses": {
          "200": {
            "description": "刪除申請的狀態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/request_account_deletion": {
      "post": {
        "operationId": "api_v1_request_account_deletion",
        "summary": "申請刪除自己的帳號（7 天冷靜期）",
        "description": "要登入，且 10 分鐘內剛完成登入（JWT amr 的時間；App 先讓使用者重新用 Google／Apple 登入）。scheduled_at＝申請＋7 天，到期後每日排程刪除。申請後立即停止公開顯示名稱。已有申請時回傳原申請，不重設日期，也不需要重新登入。冷靜期內登入不會自動取消，只有 cancel_account_deletion 會取消。錯誤：401 auth.sign_in_required、401 auth.recent_sign_in_required（details 帶 max_age_seconds）、403 account.admin_cannot_self_delete（管理員要先由別的管理員移除權限）、400 request.invalid（p_source）。",
        "x-requires-sign-in": true,
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "p_source": {
                    "type": "string",
                    "enum": [
                      "app",
                      "web"
                    ],
                    "default": "app",
                    "description": "從哪裡申請：App 內（app）或 App 外的刪除網頁（web），只記在稽核"
                  }
                },
                "example": {
                  "p_source": "app"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "刪除申請的狀態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/cancel_account_deletion": {
      "post": {
        "operationId": "api_v1_cancel_account_deletion",
        "summary": "取消自己的刪除申請",
        "description": "要登入。冷靜期內任何時候都可以取消，取消後名稱恢復顯示；沒有申請也回成功（status none）。錯誤：401 auth.sign_in_required、409 account.deletion_in_progress（排程正在刪除這個帳號）。",
        "x-requires-sign-in": true,
        "responses": {
          "200": {
            "description": "刪除申請的狀態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/spots_by_ids": {
      "post": {
        "operationId": "api_v1_spots_by_ids",
        "summary": "依 id 讀多個停車點（收藏頁）",
        "description": "一次最多 200 個 id：社群點用 uuid，官方點用 official:<uuid>。看不到（被隱藏、刪除、官方點未生效）或認不得的 id（例如舊版 tdx: 收藏）不回傳，重複的 id 只回一次。每列和 spots_in_viewport 相同，含 contributor_handle 與 is_own（依登入身分）；官方點在前、社群點在後，各依 id 排序。不需要登入。錯誤：400 request.too_many_ids（超過 200 個）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "additionalProperties": false,
                "properties": {
                  "ids": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "type": "string"
                    },
                    "description": "停車點 id"
                  }
                },
                "example": {
                  "ids": [
                    "00000000-0000-4000-8000-000000000000",
                    "official:00000000-0000-4000-8000-000000000000"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "依 id 讀多個停車點（收藏頁）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpotsByIds"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/hidden_riders_list": {
      "post": {
        "operationId": "api_v1_hidden_riders_list",
        "summary": "自己隱藏的車友",
        "description": "要登入（不可匿名登入）。只回自己的清單，依隱藏時間新到舊。錯誤：401 auth.sign_in_required。",
        "x-requires-sign-in": true,
        "responses": {
          "200": {
            "description": "自己隱藏的車友",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HiddenRiders"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/hidden_riders_merge": {
      "post": {
        "operationId": "api_v1_hidden_riders_merge",
        "summary": "把隱藏的車友併入帳號",
        "description": "要登入（不可匿名登入）。登入後上傳本機清單取聯集，也用來新增一筆。同一代號保留較早的 hidden_at 與當時的名稱。一次最多 500 筆；hidden_at 不可晚於現在 5 分鐘以上。合併後超過每帳號 500 筆時整批不寫入。不檢查代號是否存在。回傳合併後的完整清單。錯誤：400 request.invalid（detail.field）、400 hidden_riders.too_many（detail.limit）、401 auth.sign_in_required。",
        "x-requires-sign-in": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/HiddenRider"
                    }
                  }
                },
                "example": {
                  "items": [
                    {
                      "handle": "3fa8c1d27b9e40a6c55d0e1f2a3b4c5d",
                      "name_at_hide": "阿明",
                      "spot_name_at_hide": "市府轉運站機車區",
                      "hidden_at": "2026-11-02T10:00:00+08:00"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "把隱藏的車友併入帳號",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HiddenRiders"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/hidden_riders_remove": {
      "post": {
        "operationId": "api_v1_hidden_riders_remove",
        "summary": "解除隱藏一位車友",
        "description": "要登入（不可匿名登入）。從自己的清單移除一個代號；不在清單裡也成功。回傳移除後的完整清單。錯誤：400 request.invalid、401 auth.sign_in_required。",
        "x-requires-sign-in": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "handle"
                ],
                "additionalProperties": false,
                "properties": {
                  "handle": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  }
                },
                "example": {
                  "handle": "3fa8c1d27b9e40a6c55d0e1f2a3b4c5d"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "解除隱藏一位車友",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HiddenRiders"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClientConfig": {
        "type": "object",
        "required": [
          "min_supported_app_version",
          "rules_version",
          "spots_version",
          "availability_beta_cities"
        ],
        "additionalProperties": false,
        "properties": {
          "min_supported_app_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "低於這個版本的 App 一律整個擋下，必須更新才能繼續使用（使用者決定，#195 §7 第 7 題）。伺服器寧可不擋：沒有設定、格式不對或讀取失敗時回 0.1.0。App 離線或讀不到 client_config 時也不可以擋。只有 admin_v1.set_min_supported_app_version 能修改，每次修改都留稽核紀錄。"
          },
          "rules_version": {
            "type": "integer",
            "minimum": 1,
            "description": "data_versions 的 rules 版本"
          },
          "spots_version": {
            "type": "integer",
            "minimum": 1,
            "description": "data_versions 的 spots 版本"
          },
          "availability_beta_cities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "官方即時車位仍在 Beta 的縣市（例如 臺北市），依名稱排序；App 依此顯示 Beta 標示，結束 Beta 不需發版。沒有就是空陣列"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "SQLSTATE；API 自訂錯誤為 PTxyz，HTTP 狀態即 xyz"
          },
          "message": {
            "type": "string",
            "description": "穩定錯誤碼，例如 auth.aal2_required；用戶端依此顯示文案"
          },
          "details": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON 字串，帶欄位等細節"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CityRules": {
        "type": "object",
        "required": [
          "rules_version",
          "rules"
        ],
        "additionalProperties": false,
        "properties": {
          "rules_version": {
            "type": "integer",
            "minimum": 1,
            "description": "整份規則的版本，與 client_config 的 rules_version 相同"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CityRule"
            },
            "description": "依 city、vehicle 排序；沒有規則就是空陣列"
          }
        }
      },
      "CityRule": {
        "type": "object",
        "description": "一個縣市對一種車的停車規則（city_rules_data 的一列）",
        "required": [
          "city",
          "vehicle",
          "allowed_space_types",
          "conditional_space_types",
          "district_space_types",
          "districts",
          "restriction",
          "fee_note",
          "exceptions",
          "can_use_two_spaces",
          "effective_date",
          "expires_on",
          "source_url",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1,
            "description": "縣市，或「全國」"
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "scooter",
              "heavy"
            ]
          },
          "allowed_space_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "可停的格位類型"
          },
          "conditional_space_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "有條件可停的格位類型"
          },
          "district_space_types": {
            "type": "object",
            "description": "只在部分行政區開放的格位類型：格位類型 → 行政區清單"
          },
          "districts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "規則適用的行政區；空陣列表示全區"
          },
          "restriction": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pilot_area",
              "signage",
              "unverified",
              null
            ],
            "description": "有條件可停時的限制種類"
          },
          "fee_note": {
            "type": "string"
          },
          "exceptions": {
            "type": "string"
          },
          "can_use_two_spaces": {
            "type": "boolean"
          },
          "effective_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "expires_on": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "從這天起（臺灣日期）規則過期；null 表示沒有期限"
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "這條規則的版本"
          }
        }
      },
      "SpotsInViewport": {
        "type": "object",
        "required": [
          "spots",
          "truncated",
          "official_unavailable"
        ],
        "additionalProperties": false,
        "properties": {
          "spots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Spot"
            },
            "description": "官方點在前、社群點在後，各依 id 排序"
          },
          "truncated": {
            "type": "boolean",
            "description": "任一層超過 500 筆，請縮小範圍"
          },
          "official_unavailable": {
            "type": "boolean",
            "description": "官方點這次沒有讀到（暫時無法讀取）"
          }
        }
      },
      "Spot": {
        "type": "object",
        "description": "地圖上的一個停車點（官方或社群）",
        "required": [
          "id",
          "source",
          "name",
          "lat",
          "lng"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "官方點為 official: 加上 uuid"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "official、community 或其他資料來源"
          },
          "source_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "district": {
            "type": [
              "string",
              "null"
            ]
          },
          "space_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "fee_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
