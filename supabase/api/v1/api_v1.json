{
  "openapi": "3.1.0",
  "info": {
    "title": "機車停車指南 公開 API（api_v1）",
    "version": "1.0.0",
    "description": "App 與管理站共用的公開 API（#195）。每支函式是 PostgREST 的 RPC：POST /rest/v1/rpc/<name>，以 Content-Profile: api_v1 指定 schema（x-content-profile；由用戶端的 base 自動帶上，不是每支 operation 的參數）。v1 只做加法，破壞性變更開 api_v2。"
  },
  "x-content-profile": "api_v1",
  "servers": [
    {
      "url": "/rest/v1"
    }
  ],
  "paths": {
    "/rpc/client_config": {
      "post": {
        "operationId": "api_v1_client_config",
        "summary": "最低支援版本與各資料集的版本",
        "description": "App 啟動、回到前景、恢復連線時讀取（#195 §2.1、#202）。不需要登入。",
        "responses": {
          "200": {
            "description": "版本資訊",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfig"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/city_rules": {
      "post": {
        "operationId": "api_v1_city_rules",
        "summary": "全部縣市規則與整體的規則版本",
        "description": "App 在 client_config 的 rules_version 比快取新時讀取（#195 P2、#202）；資料列照原樣提供，過期（expires_on）由 App 自行判斷，判斷結果一律在 App 本地計算。不需要登入。",
        "responses": {
          "200": {
            "description": "規則",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityRules"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/account_deletion_status": {
      "post": {
        "operationId": "api_v1_account_deletion_status",
        "summary": "自己帳號的刪除申請狀態",
        "description": "要登入（不可匿名登入）。App 登入後讀取：status 為 pending 時顯示預定刪除時間與取消按鈕；cancelled_by_sign_in 為 true 且 cancelled_at 是新的，顯示「已取消刪除」（#215）。錯誤：401 auth.sign_in_required。",
        "x-requires-sign-in": true,
        "responses": {
          "200": {
            "description": "刪除申請的狀態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/request_account_deletion": {
      "post": {
        "operationId": "api_v1_request_account_deletion",
        "summary": "申請刪除自己的帳號（7 天冷靜期）",
        "description": "要登入，且 10 分鐘內剛完成登入（JWT amr 的時間；App 先讓使用者重新用 Google／Apple 登入）。scheduled_at＝申請＋7 天，到期後每日排程刪除。申請後立即停止公開顯示名稱。已有申請時回傳原申請，不重設日期，也不需要重新登入。冷靜期內新的登入會自動取消申請。錯誤：401 auth.sign_in_required、401 auth.recent_sign_in_required（details 帶 max_age_seconds）、403 account.admin_cannot_self_delete（管理員要先由別的管理員移除權限）、400 request.invalid（p_source）。",
        "x-requires-sign-in": true,
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "p_source": {
                    "type": "string",
                    "enum": [
                      "app",
                      "web"
                    ],
                    "default": "app",
                    "description": "從哪裡申請：App 內（app）或 App 外的刪除網頁（web），只記在稽核"
                  }
                },
                "example": {
                  "p_source": "app"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "刪除申請的狀態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/rpc/cancel_account_deletion": {
      "post": {
        "operationId": "api_v1_cancel_account_deletion",
        "summary": "取消自己的刪除申請",
        "description": "要登入。冷靜期內任何時候都可以取消，取消後名稱恢復顯示；沒有申請也回成功（status none）。錯誤：401 auth.sign_in_required、409 account.deletion_in_progress（排程正在刪除這個帳號）。",
        "x-requires-sign-in": true,
        "responses": {
          "200": {
            "description": "刪除申請的狀態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClientConfig": {
        "type": "object",
        "required": [
          "min_supported_app_version",
          "rules_version",
          "spots_version",
          "availability_beta_cities"
        ],
        "additionalProperties": false,
        "properties": {
          "min_supported_app_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "低於這個版本的 App 一律整個擋下，必須更新才能繼續使用（使用者決定，#195 §7 第 7 題）。伺服器寧可不擋：沒有設定、格式不對或讀取失敗時回 0.1.0。App 離線或讀不到 client_config 時也不可以擋。只有 admin_v1.set_min_supported_app_version 能修改，每次修改都留稽核紀錄。"
          },
          "rules_version": {
            "type": "integer",
            "minimum": 1,
            "description": "data_versions 的 rules 版本"
          },
          "spots_version": {
            "type": "integer",
            "minimum": 1,
            "description": "data_versions 的 spots 版本"
          },
          "availability_beta_cities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "官方即時車位仍在 Beta 的縣市（例如 臺北市），依名稱排序；App 依此顯示 Beta 標示，結束 Beta 不需發版。沒有就是空陣列"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "SQLSTATE；API 自訂錯誤為 PTxyz，HTTP 狀態即 xyz"
          },
          "message": {
            "type": "string",
            "description": "穩定錯誤碼，例如 auth.aal2_required；用戶端依此顯示文案"
          },
          "details": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON 字串，帶欄位等細節"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CityRules": {
        "type": "object",
        "required": [
          "rules_version",
          "rules"
        ],
        "additionalProperties": false,
        "properties": {
          "rules_version": {
            "type": "integer",
            "minimum": 1,
            "description": "整份規則的版本，與 client_config 的 rules_version 相同"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CityRule"
            },
            "description": "依 city、vehicle 排序；沒有規則就是空陣列"
          }
        }
      },
      "CityRule": {
        "type": "object",
        "description": "一個縣市對一種車的停車規則（city_rules_data 的一列）",
        "required": [
          "city",
          "vehicle",
          "allowed_space_types",
          "conditional_space_types",
          "district_space_types",
          "districts",
          "restriction",
          "fee_note",
          "exceptions",
          "can_use_two_spaces",
          "effective_date",
          "expires_on",
          "source_url",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1,
            "description": "縣市，或「全國」"
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "scooter",
              "heavy"
            ]
          },
          "allowed_space_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "可停的格位類型"
          },
          "conditional_space_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "有條件可停的格位類型"
          },
          "district_space_types": {
            "type": "object",
            "description": "只在部分行政區開放的格位類型：格位類型 → 行政區清單"
          },
          "districts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "規則適用的行政區；空陣列表示全區"
          },
          "restriction": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pilot_area",
              "signage",
              "unverified",
              null
            ],
            "description": "有條件可停時的限制種類"
          },
          "fee_note": {
            "type": "string"
          },
          "exceptions": {
            "type": "string"
          },
          "can_use_two_spaces": {
            "type": "boolean"
          },
          "effective_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "expires_on": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "從這天起（臺灣日期）規則過期；null 表示沒有期限"
          },
          "source_url": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "這條規則的版本"
          }
        }
      },
      "AccountDeletionState": {
        "type": "object",
        "description": "帳號刪除申請的狀態（#215）",
        "required": [
          "status",
          "requested_at",
          "scheduled_at",
          "cancelled_at",
          "cancelled_by_sign_in"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "pending"
            ],
            "description": "none：沒有申請；pending：冷靜期中，到 scheduled_at 後刪除"
          },
          "requested_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。申請時間；none 時為 null"
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。最早刪除時間（申請＋7 天），實際在之後的每日排程（台灣 03:41）執行；none 時為 null"
          },
          "cancelled_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 時間。最近一次取消的時間；沒有取消過或之後又申請時為 null"
          },
          "cancelled_by_sign_in": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "最近一次取消是否由新的登入自動觸發；沒有取消紀錄時為 null"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "錯誤（#195 §2.4）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
