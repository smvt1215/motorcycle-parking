{
  "comment": "停放條件與費率的三端契約（docs/designs/2026-10-26-parking-conditions-and-fees.md §1、§2.2、§4）。validate.ts 直接 import；lib/models/parking_condition.dart 鏡像常數並由 test/parking_contract_test.dart 逐欄比對；tool/gen_contract_sql.py 由此產生 supabase/contract/parking_contract.sql 與 supabase/tests/parking_contract_test.sql。改這個檔案後重跑產生器。",
  "version": 1,
  "space_types": [
    "paidMotorcycle",
    "freeMotorcycle",
    "heavyOnly",
    "car",
    "offStreet",
    "disabledMotorcycle",
    "timedMotorcycle",
    "flexShared",
    "evMotorcycle"
  ],
  "access_kinds": [
    "scooterOnly",
    "scooterHeavy",
    "heavyCar",
    "noMotorcycle",
    "heavyOnly"
  ],
  "placement": {
    "off_street_space_types": [
      "offStreet"
    ],
    "off_street_facility_types": [
      "multiStorey",
      "underground",
      "surface"
    ]
  },
  "time": {
    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
    "days": [
      "all",
      "weekday",
      "holiday"
    ],
    "weekdays": [
      "mon",
      "tue",
      "wed",
      "thu",
      "fri",
      "sat",
      "sun"
    ],
    "optional_pair": [
      "from",
      "to"
    ],
    "comment": "from > to 表示跨午夜；from 與 to 不可相同。全天以同時省略 from 與 to 表示（不用 00:00–24:00）；只省略其中一個不合法。days 為列舉值，或不重複的星期陣列。"
  },
  "date": {
    "pattern": "^(19|[2-9][0-9])[0-9]{2}-[0-9]{2}-[0-9]{2}$",
    "comment": "年份 1900–9999，必須是存在的日期；effective_date 與 expires_on 都有時 expires_on 必須較晚。"
  },
  "condition": {
    "keys": [
      "bay",
      "use",
      "share",
      "charge",
      "limits",
      "schedule",
      "basis"
    ],
    "zone_keys": [
      "allow"
    ],
    "bay": [
      "motorcycle",
      "heavy",
      "car"
    ],
    "use": [
      "usual",
      "share"
    ],
    "share": {
      "scooter_heavy": "motorcycle",
      "car_motorcycle": "car"
    },
    "charge": [
      "toll",
      "free"
    ],
    "limits": {
      "time_limit": {
        "required": [],
        "optional": {
          "max_minutes": {
            "min": 1,
            "max": 1440
          }
        }
      },
      "special_vehicle": {
        "required": [
          "vehicle"
        ],
        "optional": {}
      },
      "ev_only": {
        "required": [],
        "optional": {}
      }
    },
    "special_vehicles": [
      "disabled_modified"
    ],
    "street_charge_optional_with": [
      "time_limit",
      "special_vehicle",
      "ev_only"
    ],
    "allow_keys": [
      "scooter",
      "heavy"
    ],
    "schedule": {
      "keys": [
        "days",
        "from",
        "to",
        "vehicles"
      ],
      "max_entries": 8,
      "vehicles": [
        "scooter",
        "heavy",
        "car"
      ]
    },
    "basis": {
      "keys": [
        "source_url",
        "evidence_id",
        "effective_date",
        "expires_on"
      ],
      "required_one_of": [
        "source_url",
        "evidence_id"
      ],
      "reserved": [
        "evidence_id"
      ],
      "source_url": {
        "pattern": "^https://\\S+$",
        "max_length": 2048,
        "length_unit": "utf16",
        "comment": "max_length 以 UTF-16 code unit 計（BMP 以外的字元算 2），與 Dart String.length、JS length 相同；SQL 另外加計。"
      }
    }
  },
  "zone": {
    "area": [
      "motorcycle",
      "car",
      "heavy",
      "mixed"
    ],
    "comment": "parking_zones[] 的區域（§1.1）：機車區、汽車區、重機專區、混合；未填即省略鍵。只用在路外分區。分區的 condition 以 condition 段的規則加 zone_keys 檢查。分區有 condition 時，allow 必填（scooter、heavy 兩鍵），且 access 必須等於轉換層由 condition 推導的值（to_access）；推導不出或不一致，DB 拒絕寫入（決定 32，zone_condition_consistent）。沒有 condition 的分區不檢查，由 access 推導。舊版只讀 access，所以分區有 condition 時，只有 condition 為 legacy-safe 且 access 等於 to_access，該分區才算 legacy-safe。"
  },
  "conversion": {
    "from_space_type": {
      "paidMotorcycle": {
        "bay": "motorcycle",
        "use": "usual",
        "charge": "toll"
      },
      "freeMotorcycle": {
        "bay": "motorcycle",
        "use": "usual",
        "charge": "free"
      },
      "heavyOnly": {
        "bay": "heavy",
        "use": "usual"
      },
      "car": {
        "bay": "car",
        "use": "usual"
      },
      "offStreet": null,
      "disabledMotorcycle": {
        "bay": "motorcycle",
        "limits": [
          {
            "kind": "special_vehicle",
            "vehicle": "disabled_modified"
          }
        ]
      },
      "timedMotorcycle": {
        "bay": "motorcycle",
        "use": "usual",
        "limits": [
          {
            "kind": "time_limit"
          }
        ]
      },
      "flexShared": {
        "bay": "car",
        "use": "share",
        "share": "car_motorcycle"
      },
      "evMotorcycle": {
        "bay": "motorcycle",
        "limits": [
          {
            "kind": "ev_only"
          }
        ]
      }
    },
    "from_access": {
      "scooterOnly": {
        "bay": "motorcycle",
        "use": "usual",
        "allow": {
          "scooter": true,
          "heavy": false
        }
      },
      "scooterHeavy": {
        "bay": "motorcycle",
        "use": "share",
        "share": "scooter_heavy",
        "allow": {
          "scooter": true,
          "heavy": true
        }
      },
      "heavyCar": {
        "bay": "car",
        "use": "usual",
        "allow": {
          "scooter": false,
          "heavy": true
        }
      },
      "heavyOnly": {
        "bay": "heavy",
        "use": "usual",
        "allow": {
          "scooter": false,
          "heavy": true
        }
      },
      "noMotorcycle": {
        "allow": {
          "scooter": false,
          "heavy": false
        }
      }
    },
    "to_space_type": [
      {
        "when": {
          "placement": "off_street"
        },
        "space_type": "offStreet"
      },
      {
        "when": {
          "limit": "special_vehicle"
        },
        "space_type": "disabledMotorcycle"
      },
      {
        "when": {
          "limit": "ev_only"
        },
        "space_type": "evMotorcycle"
      },
      {
        "when": {
          "share": "car_motorcycle"
        },
        "space_type": "flexShared"
      },
      {
        "when": {
          "limit": "time_limit"
        },
        "space_type": "timedMotorcycle"
      },
      {
        "when": {
          "bay": "heavy"
        },
        "space_type": "heavyOnly"
      },
      {
        "when": {
          "bay": "car"
        },
        "space_type": "car"
      },
      {
        "when": {
          "bay": "motorcycle",
          "charge": "toll"
        },
        "space_type": "paidMotorcycle"
      },
      {
        "when": {
          "bay": "motorcycle",
          "charge": "free"
        },
        "space_type": "freeMotorcycle"
      }
    ],
    "to_access": "allow 與 from_access 的 allow 相同，且 from_access 有 bay 時 bay 也相同",
    "legacy_safe": {
      "comment": "conditionOf(legacySpaceType(c)) 與 c 比較時可以遺失的資訊（§1.3）：(a) share=scooter_heavy 讀回 usual；(b) 沒有 expires_on 的 basis；(c) time_limit.max_minutes；(d) lossy_when_unconfirmed 中讀回後為未確認的面向，但 assumed_charge 列出的舊值除外（舊版把限時格當收費格，charge 只能是該值或未確認）。unsafe_keys 與 unsafe_basis_keys 出現即不安全。分區：condition 依 to_access 對到 access，再由 from_access 讀回，可遺失 (b) 與 (d)；有 limits 也不安全（from_access 沒有 limits）。",
      "unsafe_keys": [
        "schedule"
      ],
      "unsafe_basis_keys": [
        "expires_on"
      ],
      "lossy_share": "scooter_heavy",
      "lossy_limit_keys": [
        "max_minutes"
      ],
      "assumed_charge": {
        "timedMotorcycle": "toll"
      },
      "lossy_when_unconfirmed": [
        "bay",
        "use",
        "share",
        "charge"
      ]
    }
  },
  "fee": {
    "max_bytes": 8192,
    "vehicles": [
      "scooter",
      "heavy",
      "car"
    ],
    "follow": {
      "vehicles": [
        "heavy"
      ],
      "modes": [
        "same_as_scooter",
        "same_as_car"
      ],
      "optional": {
        "factor_pct": {
          "min": 100,
          "max": 1000
        }
      }
    },
    "modes": {
      "free": {
        "required": {},
        "optional": {}
      },
      "posted": {
        "required": {},
        "optional": {}
      },
      "hourly": {
        "required": {
          "amount": {
            "min": 0,
            "max": 10000
          },
          "per_minutes": {
            "min": 1,
            "max": 1440
          }
        },
        "optional": {
          "unit_minutes": {
            "min": 1,
            "max": "per_minutes"
          },
          "free_minutes": {
            "min": 1,
            "max": 1440
          },
          "daily_cap": {
            "min": 0,
            "max": 10000
          },
          "cap_reset": "cap_reset"
        }
      },
      "per_visit": {
        "required": {
          "amount": {
            "min": 0,
            "max": 10000
          }
        },
        "optional": {
          "max_minutes": {
            "min": 1,
            "max": 1440
          },
          "renew": "renew",
          "extension": "extension"
        }
      },
      "daily": {
        "required": {
          "amount": {
            "min": 0,
            "max": 10000
          }
        },
        "optional": {
          "cap_reset": "cap_reset"
        }
      },
      "by_time": {
        "required": {
          "periods": "periods"
        },
        "optional": {
          "cross_period": "cross_period"
        }
      }
    },
    "enums": {
      "cap_reset": [
        "calendar_day",
        "rolling_24h",
        "per_entry"
      ],
      "renew": [
        "none",
        "midnight"
      ],
      "cross_period": [
        "each_period",
        "entry_only"
      ]
    },
    "extension": {
      "required": {
        "amount": {
          "min": 0,
          "max": 10000
        },
        "max_times": {
          "min": 1,
          "max": 10
        }
      },
      "optional": {
        "minutes": {
          "min": 1,
          "max": 1440
        }
      }
    },
    "periods": {
      "max_entries": 6,
      "keys": [
        "days",
        "from",
        "to",
        "rate"
      ],
      "nested_modes": [
        "free",
        "posted",
        "hourly",
        "per_visit",
        "daily"
      ]
    },
    "comment": "max_bytes 是資料表的保險上限（pg_column_size），刻意大於契約允許的最大費率（tool/fee_text.py 的 largest_fee，三端共同測試），所以合法形狀的費率不會因大小被任何一端拒絕。"
  }
}
