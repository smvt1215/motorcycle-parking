# TDX credentials for tool/import_mymaps.py static verification only (the app has no live TDX layer).
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# Set a random secret in staging/production; hashes IP addresses, never stores raw IPs.
REPORT_HASH_SECRET=local-development-only-replace-in-cloud
# Authenticated reporting fails closed unless the deployment's gateway supplies this header.
TRUSTED_IP_HEADER=x-forwarded-for
# Server key restricted to the Geocoding API (geocode function). Unset: address search answers not_configured.
GOOGLE_GEOCODING_API_KEY=
