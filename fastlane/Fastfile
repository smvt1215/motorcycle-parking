require "base64"
require "digest"
require "fileutils"
require "json"
require_relative "release_policy"
require_relative "device_policy"

STAGING_BUNDLE = "tw.motopark.motorcycleParking.staging"

def root_path(path)
  File.expand_path("../#{path}", __dir__)
end

def required_setting(name)
  value = ENV.fetch(name, "")
  UI.user_error!("Missing Environment setting: #{name}") if value.empty?
  value
end

def record_hash(platform, number, binary)
  destination = File.join(ENV.fetch("RUNNER_TEMP"), "sha256-#{platform}-#{number}.txt")
  extension = File.extname(binary)
  File.write(destination, "#{Digest::SHA256.file(binary).hexdigest}  #{platform}-#{number}#{extension}\n")
  # Record before the store write so a retry after a successful upload can
  # recover the original binary's hash without rebuilding a different binary.
  sh("gh", "release", "upload", ENV.fetch("GITHUB_REF_NAME"), destination, "--clobber")
end

def selected_build(number)
  File.open(ENV.fetch("GITHUB_OUTPUT"), "a") { |file| file.puts("build=#{number}") }
end

def connect_api_key
  app_store_connect_api_key(key_id: required_setting("APP_STORE_KEY_ID"),
                            issuer_id: required_setting("APP_STORE_ISSUER_ID"),
                            key_content: required_setting("APP_STORE_KEY_BASE64"),
                            is_key_content_base64: true, duration: 1200)
end

# The owner creates the first Ad Hoc profile by hand; automation only refreshes it.
def find_staging_profile
  profiles = Spaceship::ConnectAPI::Profile.all(filter: {profileType: "IOS_APP_ADHOC"},
                                                includes: "bundleId,certificates,devices")
  matching = profiles.select { |profile| profile.bundle_id&.identifier == STAGING_BUNDLE }
  UI.user_error!("Create one Ad Hoc profile for #{STAGING_BUNDLE} first") unless matching.size == 1
  matching.first
end

platform :android do
  desc "Publish or resume a 10% production rollout without uploading twice"
  lane :release do
    require "supply"
    package = "tw.motopark.motorcycle_parking"
    credentials = required_setting("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON")
    base = Integer(ENV.fetch("BUILD_BASE"))
    number = Integer(ENV.fetch("BUILD_NUMBER"))
    # List every track, including any custom tracks, in a read-only edit.
    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options,
                                                       package_name: package, json_key_data: credentials)
    client = Supply::Client.make_from_config
    tracks = {}
    production_releases = []
    begin
      client.begin_edit(package_name: package)
      client.tracks.each do |track|
        tracks[track.track] = Array(track.releases).flat_map { |release| Array(release.version_codes) }.map(&:to_i)
        production_releases = Array(track.releases) if track.track == "production"
      end
    ensure
      client.abort_current_edit
    end
    released_codes = ReleasePolicy.published_play_codes(production_releases)
    existing = ReleasePolicy.play_candidate(tracks.to_a, base, released_codes: released_codes)
    common = {package_name: package, json_key_data: credentials,
              skip_upload_metadata: true, skip_upload_images: true,
              skip_upload_screenshots: true, skip_upload_changelogs: true,
              rescue_changes_not_sent_for_review: false}
    if existing && released_codes.include?(existing)
      UI.success("This commit has already been published on the production track")
      selected_build(existing)
    elsif existing
      source = tracks.find { |_, codes| codes.include?(existing) }.first
      upload_to_play_store(**common, track: source, track_promote_to: "production",
                           version_code: existing, track_promote_release_status: "inProgress", rollout: 0.1,
                           skip_upload_apk: true, skip_upload_aab: true)
      selected_build(existing)
    else
      sh("python3", root_path("tool/cd_config.py"), "production", "android")
      # GITHUB_ENV affects the next step; this build runs in the same step.
      ENV["ANDROID_KEYSTORE_PATH"] = File.join(ENV.fetch("RUNNER_TEMP"), "upload.jks")
      sh("flutter", "build", "appbundle", "--release", "--flavor", "production",
         "--build-name=#{ENV.fetch('RELEASE_VERSION')}", "--build-number=#{number}",
         "--dart-define-from-file=#{root_path('config/production.json')}")
      binary = root_path("build/app/outputs/bundle/productionRelease/app-production-release.aab")
      record_hash("android", number, binary)
      upload_to_play_store(**common, aab: binary, track: "production", release_status: "inProgress", rollout: 0.1,
                           version_name: ENV.fetch("RELEASE_VERSION"))
      selected_build(number)
    end
  end
end

platform :ios do
  desc "Register new Firebase testers' iPhones and refresh the staging Ad Hoc profile"
  lane :staging_devices do
    connect_api_key
    testers = JSON.parse(File.read(ENV.fetch("TESTER_UDIDS_FILE")))
    limit = Integer(ENV.fetch("IOS_DEVICE_LIMIT", "").then { |value| value.empty? ? DevicePolicy::DEFAULT_LIMIT.to_s : value })
    registered = Spaceship::ConnectAPI::Device.all(filter: {platform: "IOS"})
    add, over = DevicePolicy.to_register(testers, registered.map(&:udid), limit)
    UI.important("#{over.size} tester iPhone(s) not registered: staging limit of #{limit} reached") unless over.empty?
    add.each do |device|
      Spaceship::ConnectAPI::Device.create(name: DevicePolicy.device_name(device), platform: "IOS", udid: device["udid"])
    end
    UI.message("Registered #{add.size} new iPhone(s)")
    # Rebuild only when the profile misses an enabled device, whether just
    # registered here or added by hand in the developer portal.
    enabled = Spaceship::ConnectAPI::Device.all(filter: {platform: "IOS", status: "ENABLED"})
    profile = find_staging_profile
    missing = enabled.map(&:id) - profile.devices.map(&:id)
    if missing.any?
      name = profile.name
      certificates = profile.certificates.map(&:id)
      bundle_id = profile.bundle_id.id
      # Profile names are unique, so the old one goes first; Signing.xcconfig keeps using the name.
      profile.delete!
      Spaceship::ConnectAPI::Profile.create(name: name, profile_type: "IOS_APP_ADHOC", bundle_id_id: bundle_id,
                                            certificate_ids: certificates, device_ids: enabled.map(&:id))
      UI.success("Refreshed #{name} with #{enabled.size} device(s)")
    end
    File.open(ENV.fetch("GITHUB_OUTPUT"), "a") { |file| file.puts("rebuild=#{missing.any?}") }
  end

  desc "Download the current staging Ad Hoc profile for this build"
  lane :staging_profile do
    connect_api_key
    profile = find_staging_profile
    UI.user_error!("Staging Ad Hoc profile is #{profile.profile_state}") unless profile.profile_state == "ACTIVE"
    path = File.join(ENV.fetch("RUNNER_TEMP"), "staging-adhoc.mobileprovision")
    File.binwrite(path, Base64.decode64(profile.profile_content))
    File.chmod(0o600, path)
    File.open(ENV.fetch("GITHUB_ENV"), "a") { |file| file.puts("IOS_PROFILE_PATH=#{path}") }
  end

  desc "Reuse a valid build, then independently ensure App Store review submission"
  lane :release do
    api_key = connect_api_key
    app_id = required_setting("APP_STORE_APP_ID")
    version = ENV.fetch("RELEASE_VERSION")
    base = Integer(ENV.fetch("BUILD_BASE"))
    number = Integer(ENV.fetch("BUILD_NUMBER"))
    app = Spaceship::ConnectAPI::App.get(app_id: app_id)
    UI.user_error!("Wrong App Store app ID") unless app.bundle_id == "tw.motopark.motorcycleParking"
    store_version = app.get_app_store_versions(filter: {versionString: version, platform: "IOS"}).first
    state = store_version&.app_version_state || store_version&.app_store_state
    if ReleasePolicy.submitted?(state)
      selected = store_version.get_build
      UI.user_error!("Submitted store version uses a build outside this commit's range") unless selected && ReleasePolicy.range(base).cover?(selected.version.to_i)
      selected_build(selected.version)
      next
    end
    find_builds = lambda do
      Spaceship::ConnectAPI::Build.all(app_id: app_id, version: version, platform: "IOS",
                                      build_number: ReleasePolicy.range(base).to_a.join(","))
    end
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 3600
    builds = find_builds.call
    while ReleasePolicy.processing?(builds, base) && Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
      sleep(30)
      builds = find_builds.call
    end
    build = ReleasePolicy.valid_build(builds, base)
    unless build
      # A retry's attempt number is different; never overwrite an unresolved upload.
      if builds.any? { |item| item.version.to_i == number && item.processing_state == "PROCESSING" }
        UI.user_error!("This attempt's build is still processing; rerun the workflow for a new number")
      end
      sh("python3", root_path("tool/cd_config.py"), "production", "ios")
      sh("python3", root_path("tool/ios_signing.py"), "production")
      sh("flutter", "build", "ipa", "--release", "--build-name=#{version}", "--build-number=#{number}",
         "--dart-define-from-file=#{root_path('config/production.json')}",
         "--export-options-plist=#{ENV.fetch('RUNNER_TEMP')}/ExportOptions.plist")
      binaries = Dir[root_path("build/ios/ipa/*.ipa")]
      UI.user_error!("Expected one IPA") unless binaries.length == 1
      record_hash("ios", number, binaries.first)
      upload_to_testflight(api_key: api_key, app_identifier: app.bundle_id, apple_id: app_id,
                           ipa: binaries.first, distribute_external: false,
                           skip_waiting_for_build_processing: true)
      # Upload does not mean VALID. Wait before selecting a build for review.
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 3600
      loop do
        builds = find_builds.call
        build = ReleasePolicy.valid_build(builds, base)
        break if build
        failed = builds.any? { |item| item.version.to_i == number && %w[FAILED INVALID].include?(item.processing_state) }
        UI.user_error!("App Store rejected processing; fix the binary before retrying") if failed
        UI.user_error!("App Store processing timed out; rerun to check the uploaded build") if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
        sleep(30)
      end
    end
    store_version = app.get_app_store_versions(filter: {versionString: version, platform: "IOS"}).first
    state = store_version&.app_version_state || store_version&.app_store_state
    if ReleasePolicy.submitted?(state)
      selected = store_version.get_build
      UI.user_error!("Submitted store version uses a build outside this commit's range") unless selected && ReleasePolicy.range(base).cover?(selected.version.to_i)
      selected_build(selected.version)
    else
      # Submission runs even when an earlier attempt already uploaded the IPA.
      upload_to_app_store(api_key: api_key, app_identifier: app.bundle_id, app_version: version,
                          build_number: build.version, skip_binary_upload: true,
                          metadata_path: root_path("fastlane/metadata/ios"),
                          skip_screenshots: Dir[root_path("fastlane/metadata/ios/*/screenshots/*")].empty?,
                          submit_for_review: true, automatic_release: true, phased_release: true, force: true,
                          copyright: required_setting("APP_STORE_COPYRIGHT"),
                          support_url: {"zh-Hant" => required_setting("APP_STORE_SUPPORT_URL")},
                          privacy_url: {"zh-Hant" => required_setting("APP_STORE_PRIVACY_URL")},
                          submission_information: JSON.parse(required_setting("APP_STORE_SUBMISSION_INFORMATION")))
      selected_build(build.version)
    end
  end
end
