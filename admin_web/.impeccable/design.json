  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "套用建議、儲存並關閉等主要動作；只有按得下去的東西才用操作藍。",
      "html": "<button class=\"ds-btn ds-btn-p\">套用建議 <kbd class=\"ds-kbd\">A</kbd></button>",
      "css": ".ds-btn{min-height:48px;padding:0 18px;border-radius:6px;border:1px solid #9AA0A6;background:#fff;color:#16181A;font:500 15px 'Noto Sans TC',sans-serif;display:inline-flex;align-items:center;gap:10px;cursor:pointer}.ds-btn-p{background:#1F5FA8;border-color:#1F5FA8;color:#fff}.ds-btn-p:hover{background:#164A85;border-color:#164A85}.ds-btn:focus-visible{outline:3px solid #1F5FA8;outline-offset:2px}.ds-kbd{font:700 12px/1 'Barlow Condensed',sans-serif;border:1px solid currentColor;border-radius:3px;padding:2px 5px;opacity:.8}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "修改後套用、設定開放狀態等次要動作。",
      "html": "<button class=\"ds-btn\">修改後套用</button>",
      "css": ".ds-btn{min-height:48px;padding:0 18px;border-radius:6px;border:1px solid #9AA0A6;background:#fff;color:#16181A;font:500 15px 'Noto Sans TC',sans-serif;display:inline-flex;align-items:center;gap:10px;cursor:pointer}.ds-btn:hover{border-color:#16181A}.ds-btn:focus-visible{outline:3px solid #1F5FA8;outline-offset:2px}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "駁回、刪除點位、停權；紅字紅框，不做實心紅底。",
      "html": "<button class=\"ds-btn ds-btn-x\">刪除點位</button>",
      "css": ".ds-btn{min-height:48px;padding:0 18px;border-radius:6px;border:1px solid #9AA0A6;background:#fff;color:#16181A;font:500 15px 'Noto Sans TC',sans-serif;display:inline-flex;align-items:center;gap:10px;cursor:pointer}.ds-btn-x{color:#A3241B;border-color:#D9A7A2}.ds-btn-x:hover{border-color:#A3241B}.ds-btn:focus-visible{outline:3px solid #1F5FA8;outline-offset:2px}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "單選篩選；選取時黑底白字，計數用 Barlow 數字。",
      "html": "<div style=\"display:flex;gap:8px\"><button class=\"ds-chip on\" aria-pressed=\"true\">待審 <span class=\"ds-n\">12</span></button><button class=\"ds-chip\" aria-pressed=\"false\">已刪除 <span class=\"ds-n\">4</span></button></div>",
      "css": ".ds-chip{min-height:44px;padding:0 14px;border-radius:20px;border:1px solid #9AA0A6;background:#FAFAF6;color:#16181A;font:15px 'Noto Sans TC',sans-serif;cursor:pointer}.ds-chip:hover{border-color:#16181A}.ds-chip.on{background:#16181A;border-color:#16181A;color:#fff}.ds-chip:focus-visible{outline:3px solid #1F5FA8;outline-offset:2px}.ds-n{font-family:'Barlow Condensed',sans-serif;font-variant-numeric:tabular-nums;font-weight:600}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "48px 高欄位；改過的值反光黃底加黑框。",
      "html": "<div style=\"display:flex;flex-direction:column;gap:12px;width:320px\"><label class=\"ds-field\"><span>名稱</span><input class=\"ds-input changed\" value=\"大安森林公園地下停車場（新生南路入口）\"></label><label class=\"ds-field\"><span>地址</span><input class=\"ds-input\" value=\"臺北市大安區新生南路二段 1 號\"></label></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font:700 13px 'Noto Sans TC',sans-serif;color:#16181A}.ds-input{font:15px 'Noto Sans TC',sans-serif;min-height:48px;padding:0 12px;border:1px solid #9AA0A6;border-radius:6px;background:#fff;color:#16181A;caret-color:#1F5FA8;box-sizing:border-box;width:100%}.ds-input.changed{background:#FFF3C4;border-color:#16181A}.ds-input:focus-visible{outline:3px solid #1F5FA8;outline-offset:2px}"
    },
    {
      "name": "Navigation Rail",
      "kind": "nav",
      "refersTo": "rail",
      "description": "桌機 96px 壓印黑導覽欄，選取項牌面白底，待審計數用小方牌。圖示為設計稿自繪的細線條。",
      "html": "<nav class=\"ds-rail\" aria-label=\"管理功能\"><a href=\"#\" class=\"on\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 4h6v3H9zM7 5H5v15h14V5h-2\"/><path d=\"M8.5 13l2.5 2.5 4.5-5\"/></svg>審核<span class=\"ds-cnt\">12</span></a><a href=\"#\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.2\"/></svg>點位</a><a href=\"#\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 4h10l4 4v12H5z\"/><path d=\"M9 12h6M9 16h6M9 8h3\"/></svg>規則</a></nav>",
      "css": ".ds-rail{background:#16181A;width:96px;display:flex;flex-direction:column;align-items:center;padding:18px 0;gap:6px}.ds-rail a{width:80px;min-height:64px;border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font:13px 'Noto Sans TC',sans-serif;color:#C9CDD1;text-decoration:none}.ds-rail a:hover{background:#2A2D30;color:#fff}.ds-rail a.on{background:#FAFAF6;color:#16181A;font-weight:700}.ds-rail a:focus-visible{outline:3px solid #1F5FA8;outline-offset:2px}.ds-rail svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-cnt{font:700 14px/1.2 'Barlow Condensed',sans-serif;background:#FAFAF6;color:#16181A;border-radius:3px;padding:0 6px}"
    },
    {
      "name": "Status Tags",
      "kind": "chip",
      "refersTo": "tag-status-open",
      "description": "點位開放狀態與已修改標籤：外框、反白、紅框、反光黃。",
      "html": "<div style=\"display:flex;flex-wrap:wrap;gap:8px\"><span class=\"ds-st\">正常開放</span><span class=\"ds-st on\">施工中，到 11/14</span><span class=\"ds-st del\">已刪除，13 天後永久刪除</span><span class=\"ds-st mod\">已修改</span></div>",
      "css": ".ds-st{display:inline-flex;align-items:center;height:20px;padding:0 7px;border:1.5px solid #16181A;border-radius:3px;background:#FAFAF6;color:#16181A;font:700 13px 'Noto Sans TC',sans-serif}.ds-st.on{background:#16181A;color:#fff}.ds-st.del{border-color:#A3241B;color:#A3241B}.ds-st.mod{background:#FFF3C4;padding:0 6px}"
    },
    {
      "name": "Plate Stack",
      "kind": "custom",
      "refersTo": "plate-stack",
      "description": "App 的疊牌（platesOf）：普通機車綠白、大型重機紅黃；五種狀態靠處理方式區分（全彩、缺角、灰框加 X、虛線加「?」、純虛線）。",
